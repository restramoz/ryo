# Security rules for direct public uploads
Options -Indexes -ExecCGI
php_flag engine off

<FilesMatch "\.(?i:php|phar|phtml|php3|php4|php5|phps|cgi|pl|py|sh|exe|bat|cmd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule \.(php|phar|phtml|php3|php4|php5|phps)$ - [F,L,NC]
</IfModule>

AddType text/plain .php .php3 .php4 .php5 .phtml .phar
